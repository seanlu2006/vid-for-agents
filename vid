#!/usr/bin/env bash
# vid — 把影片變成「Claude 讀得懂的東西」：抽樣影格(圖) + 逐字稿(文字) + meta
#
# 用法:
#   vid <URL或本機檔案> [選項]
#
# 選項:
#   -n, --frames N      抽幾張影格 (預設 12)
#   -l, --lang CODE     逐字稿語言 (預設 auto；中文用 zh，英文用 en)
#   -c, --cookies BROWSER  用瀏覽器 cookie 抓需登入的內容 (chrome/safari/firefox/edge)
#   -o, --outdir DIR    輸出根目錄 (預設 ~/media-out)
#       --no-frames     不抽影格（只要逐字稿）
#       --no-audio      不轉逐字稿（只要影格）
#       --no-ocr        不辨識畫面上的文字（macOS 才有，預設開）
#       --no-vad        whisper 不用 VAD 過濾靜音段（預設開）
#       --uniform       影格一律均勻抽樣，不看場景變化
#       --keep-video    保留原始影片檔（預設保留；用 --no-keep 刪掉省空間）
#       --no-keep       處理完刪掉原始影片
#       --model NAME    whisper 模型 (預設 large-v3-turbo-q5_0)
#                       自訂模型可設 WHISPER_MODEL_SHA256 讓首次下載時驗證
#   -h, --help          這段說明
#
# 輸出: <outdir>/<標題slug>-<時間戳>/
#   ├── README.md      ← 給 Claude 讀的入口（含 meta + 逐字稿全文 + 影格清單與畫面文字）
#   ├── meta.json      ← yt-dlp 抓到的原始 metadata
#   ├── frames/        ← f001.jpg ... 依時間排序，檔名含秒數
#   ├── transcript.txt ← 純文字逐字稿
#   ├── transcript.srt ← 帶時間軸
#   └── source.*       ← 原始影片

set -euo pipefail
# 所有 python3 呼叫的輸入輸出一律用 UTF-8。不設的話，在非 UTF-8 locale
# （例如 CI、LANG=C 的伺服器）印中文標題、檔名、OCR 文字會直接 UnicodeEncodeError
export PYTHONIOENCODING=utf-8

FRAMES=12
LANG_CODE="auto"
COOKIES=""
OUTROOT="$HOME/media-out"
DO_FRAMES=1
DO_AUDIO=1
DO_OCR=1
DO_VAD=1
UNIFORM=0
KEEP_VIDEO=1
MODEL="large-v3-turbo-q5_0"
MODEL_DIR="$HOME/.cache/whisper-models"
VID_CACHE="$HOME/.cache/vid"
# Silero VAD（whisper.cpp 官方轉的 ggml 版），版本與 SHA-256 取自 HF API
VAD_MODEL="silero-v6.2.0"
VAD_REVISION="9ffd54a1e1ee413ddf265af9913beaf518d1639b"
VAD_SHA256="2aa269b785eeb53a82983a20501ddf7c1d9c48e33ab63a41391ac6c9f7fb6987"
MODEL_REVISION="5359861c739e955e79d9a303bcbc70fb988958b1"
# Hugging Face LFS oid (SHA-256) for the default model at MODEL_REVISION.
DEFAULT_MODEL_SHA256="394221709cd5ad1f40c46e6031ca61bce88931e6e088c188294c6d5a55ffa7e2"

die() { echo "❌ $*" >&2; exit 1; }
info() { echo "→ $*" >&2; }

# ── slug：把標題/檔名轉成安全的目錄名 ────────────────────────────────────
# URL 與本機檔兩條路徑共用同一套規則，避免行為分歧。
# 保留 0-9 A-Z a-z 與 CJK 漢字(U+4E00-U+9FFF)，其餘一律收斂成單一 "-"。
slugify() {
  printf '%s' "$1" | python3 -c '
import re, sys
t = sys.stdin.buffer.read().decode("utf-8", "replace")
t = re.sub(r"[^0-9A-Za-z\u4e00-\u9fff]+", "-", t).strip("-")[:50].strip("-")
print(t or "video")
'
}

[[ $# -eq 0 ]] && { sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }

# ── 吃參數的選項：缺參數/型別錯，在解析階段就擋下來 ──────────────────────
# $1=選項名  $2=剩下的參數個數(含選項本身)  $3=參數值(可能不存在)
need_val() {
  local opt="$1" argc="$2" val="${3:-}"
  [[ $argc -ge 2 ]] || die "選項 $opt 需要一個參數"
  [[ -n "$val" ]] || die "選項 $opt 的參數不能是空的"
  [[ "$val" == -* ]] && die "選項 $opt 需要一個參數，但後面接到的是另一個選項: $val"
  return 0
}

INPUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--frames)
      [[ $# -ge 2 ]] || die "選項 $1 需要一個數字參數，例如: -n 12"
      [[ "$2" =~ ^[0-9]+$ ]] || die "選項 $1 需要一個大於 0 的整數，收到: $2"
      [[ "$2" -gt 0 ]] || die "選項 $1 需要一個大於 0 的整數，收到: $2"
      FRAMES="$2"; shift 2 ;;
    -l|--lang)
      need_val "$1" $# "${2:-}"
      [[ "$2" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]] || die "選項 $1 需要一個語言代碼（auto / zh / en …），收到: $2"
      LANG_CODE="$2"; shift 2 ;;
    -c|--cookies)
      need_val "$1" $# "${2:-}"
      COOKIES="$2"; shift 2 ;;
    -o|--outdir)
      need_val "$1" $# "${2:-}"
      OUTROOT="$2"; shift 2 ;;
    --model)
      need_val "$1" $# "${2:-}"
      [[ "$2" =~ ^[A-Za-z0-9._-]+$ ]] || die "選項 $1 的模型名只能有英數字與 . _ -，收到: $2"
      MODEL="$2"; shift 2 ;;
    --no-frames)  DO_FRAMES=0; shift ;;
    --no-audio)   DO_AUDIO=0; shift ;;
    --no-ocr)     DO_OCR=0; shift ;;
    --no-vad)     DO_VAD=0; shift ;;
    --uniform)    UNIFORM=1; shift ;;
    --keep-video) KEEP_VIDEO=1; shift ;;
    --no-keep)    KEEP_VIDEO=0; shift ;;
    -h|--help)    sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)           die "不認識的選項: $1" ;;
    *)            INPUT="$1"; shift ;;
  esac
done

[[ -z "$INPUT" ]] && die "要給我一個 URL 或影片檔路徑"

command -v ffmpeg  >/dev/null || die "沒裝 ffmpeg。跑: brew install ffmpeg"
command -v ffprobe >/dev/null || die "沒裝 ffprobe（在 ffmpeg 裡）"
command -v python3 >/dev/null || die "沒裝 python3。macOS 跑: xcode-select --install（或 brew install python）"

# ── whisper 二進位名字在不同版本不一樣，逐一找 ────────────────────────────
WHISPER=""
for c in whisper-cli whisper-cpp whisper main; do
  if command -v "$c" >/dev/null 2>&1; then WHISPER="$c"; break; fi
done

STAMP=$(date +%Y%m%d-%H%M%S)

# ── 暫存目錄：不管正常結束還是中途失敗（下載失敗、Ctrl-C、ffmpeg 爆掉）
#    都要清掉，別把整支影片留在 /var/folders。宣告在 TMPD 可能被建立之前，
#    並用 ${TMPD:-} 以相容 set -u。
TMPD=""
OUTDIR=""
COMPLETED=0
cleanup() {
  [[ -n "${TMPD:-}" ]] && rm -rf "$TMPD"
  # 中途失敗就把這次建立的輸出目錄整個收掉，不留半成品
  [[ $COMPLETED -eq 0 && -n "${OUTDIR:-}" ]] && rm -rf "$OUTDIR"
  return 0
}
trap cleanup EXIT

# ── 1. 取得影片：URL 就下載，本機檔就複製路徑 ─────────────────────────────
VIDEO=""
META_JSON=""

if [[ "$INPUT" =~ ^https?:// ]]; then
  command -v yt-dlp >/dev/null || die "沒裝 yt-dlp。跑: brew install yt-dlp"
  TMPD=$(mktemp -d)
  YTARGS=(-f "bv*[height<=1080]+ba/b" --merge-output-format mp4
          --write-info-json --no-playlist --restrict-filenames
          -o "$TMPD/src.%(ext)s")
  [[ -n "$COOKIES" ]] && YTARGS+=(--cookies-from-browser "$COOKIES")

  info "下載中: $INPUT"
  if ! yt-dlp "${YTARGS[@]}" "$INPUT"; then
    # Threads 沒有專屬 extractor，用 generic 撈 og:video 再試一次
    info "專屬 extractor 失敗，改用 generic 模式重試…"
    if ! yt-dlp "${YTARGS[@]}" --force-generic-extractor "$INPUT"; then
      echo "" >&2
      echo "下載失敗。常見原因：" >&2
      echo "  • 需要登入（IG/Threads 大多要）→ 加 -c chrome 用你瀏覽器的 cookie" >&2
      echo "  • Threads 目前 yt-dlp 無專屬支援，只能靠 generic 撈 og:video，不保證成功" >&2
      echo "  • yt-dlp 太舊 → brew upgrade yt-dlp" >&2
      exit 1
    fi
  fi

  VIDEO=$(find "$TMPD" -maxdepth 1 -type f ! -name '*.info.json' | head -1)
  META_JSON=$(find "$TMPD" -maxdepth 1 -name '*.info.json' | head -1)
  [[ -z "$VIDEO" ]] && die "下載完卻找不到檔案"

  RAW_TITLE=$(python3 -c "
import json,sys
try:
    d=json.load(open(sys.argv[1], encoding='utf-8'))
    t=d.get('title') or d.get('id') or 'video'
except Exception:
    t='video'
print(t)
" "$META_JSON" 2>/dev/null || echo "video")
  TITLE=$(slugify "$RAW_TITLE")
else
  [[ -f "$INPUT" ]] || die "檔案不存在: $INPUT"
  VIDEO="$INPUT"
  TITLE=$(slugify "$(basename "${INPUT%.*}")")
fi

# ── 2. 基本資訊 ──────────────────────────────────────────────────────────
DURATION_RAW=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$VIDEO" 2>/dev/null) ||
  die "ffprobe 讀取影片時長失敗"
[[ "$DURATION_RAW" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
  die "ffprobe 回傳無效的影片時長: $DURATION_RAW"
DURATION="${DURATION_RAW%%.*}"
RES=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$VIDEO" 2>/dev/null) ||
  die "ffprobe 讀取影片解析度失敗"
RES=$(printf '%s\n' "$RES" | head -1)
# 空字串 = 沒有畫面串流（podcast、語音訊息），照樣做逐字稿
[[ -z "$RES" || "$RES" =~ ^[0-9]+x[0-9]+$ ]] || die "ffprobe 回傳無效的影片解析度: $RES"

# 抽影格要照「畫面串流」的長度，不是容器長度。
# Reels 常見畫面 3 秒、配樂 10 秒，用容器長度會抽到畫面結束之後的空白時間點。
VDUR="$DURATION_RAW"
if [[ -n "$RES" ]]; then
  VDUR_RAW=$(ffprobe -v error -select_streams v:0 -show_entries stream=duration -of csv=p=0 "$VIDEO" 2>/dev/null | head -1 || true)
  # mkv/webm 常沒有串流長度（N/A），退回容器長度
  [[ "$VDUR_RAW" =~ ^[0-9]+([.][0-9]+)?$ ]] && VDUR="$VDUR_RAW"
fi
HAS_AUDIO=$(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 "$VIDEO" 2>/dev/null) ||
  die "ffprobe 讀取音軌資訊失敗"
HAS_AUDIO=$(printf '%s\n' "$HAS_AUDIO" | head -1)
info "時長 ${DURATION}s / 解析度 ${RES:-無畫面}"

mkdir -p "$OUTROOT"
OUTDIR="$OUTROOT/${TITLE}-${STAMP}"
suffix=0
while ! mkdir "$OUTDIR" 2>/dev/null; do
  [[ -e "$OUTDIR" ]] || die "無法建立輸出目錄: $OUTDIR"
  suffix=$((suffix + 1))
  OUTDIR="$OUTROOT/${TITLE}-${STAMP}-${suffix}"
done
[[ -n "$META_JSON" ]] && cp "$META_JSON" "$OUTDIR/meta.json"

# ── 3. 抽影格 ────────────────────────────────────────────────────────────
FRAME_LIST=""
FRAME_NOTE=""
if [[ $DO_FRAMES -eq 1 && -z "$RES" ]]; then
  FRAME_NOTE="（這個檔案沒有畫面）"
elif [[ $DO_FRAMES -eq 1 ]] && python3 -c "import sys; sys.exit(0 if float('$VDUR') > 0 else 1)"; then
  mkdir -p "$OUTDIR/frames"

  # 先用 scdet 算每一幀的場景變化分數（降到 6fps、320 寬，5 分鐘的片約 1 秒）。
  # 四分之一的張數留給分數最高的時間點，其餘維持均勻覆蓋：
  # 剪輯型影片（Reels）靠場景變化才抓得到快閃字卡，投影片錄影則是均勻覆蓋比較不漏。
  SCENE_RAW=""
  if [[ $UNIFORM -eq 0 ]]; then
    SCENE_RAW=$(ffmpeg -nostdin -loglevel error -i "$VIDEO" -an \
                  -vf "fps=6,scale=320:-2,scdet=threshold=0,metadata=print:file=-" \
                  -f null - 2>/dev/null || true)
    [[ -z "$SCENE_RAW" ]] && echo "⚠️  場景偵測沒有結果，改用均勻抽樣" >&2
  fi

  TIMES=$(printf '%s' "$SCENE_RAW" | python3 -c '
import re, sys
dur, n = float(sys.argv[1]), int(sys.argv[2])
cands, t = [], None
for line in sys.stdin:
    m = re.match(r"frame:\d+\s+pts:\S+\s+pts_time:([\d.]+)", line)
    if m:
        t = float(m.group(1)); continue
    m = re.match(r"lavfi\.scd\.score=([\d.]+)", line)
    if m and t is not None:
        cands.append((float(m.group(1)), t))
gap = max(0.5, dur / (n * 3))          # 兩張之間至少隔這麼久，免得全擠在同一個轉場
picked = []
def ok(x): return 0 < x < dur and all(abs(x - p) >= gap for p in picked)
for score, t in sorted(cands, reverse=True):
    if score <= 0: break
    t2 = min(t + 0.35, dur - 0.05)     # 轉場後 0.35 秒，避開淡入淡出中間
    if ok(t2): picked.append(t2)
    if len(picked) >= max(1, n // 4): break
scene_n = len(picked)

def fill(min_gap, slots):                # 其餘用均勻取樣補滿覆蓋率
    for k in range(slots):
        if len(picked) >= n: return
        t = dur * (k + 0.5) / slots
        if 0 < t < dur and all(abs(t - p) >= min_gap for p in picked):
            picked.append(t)

fill(gap, n)
fill(gap / 2, n * 2)                     # 還不夠就放寬間隔，張數要湊滿
fill(0.05, n * 4)
print(scene_n, file=sys.stderr)
for t in sorted(picked)[:n]: print(round(t, 2))
' "$VDUR" "$FRAMES" 2>"$OUTDIR/.scene_n")
  SCENE_N=$(cat "$OUTDIR/.scene_n" 2>/dev/null || echo 0); rm -f "$OUTDIR/.scene_n"
  if [[ "${SCENE_N:-0}" -gt 0 ]]; then
    info "抽 $FRAMES 張影格（場景變化 ${SCENE_N} 張 + 均勻覆蓋 $((FRAMES - SCENE_N)) 張）…"
  else
    info "抽 $FRAMES 張影格（均勻抽樣）…"
  fi

  SKIPPED=0
  i=1
  while read -r T; do
    [[ -z "$T" ]] && continue
    MM=$(python3 -c "print(f'{int($T)//60:02d}m{int($T)%60:02d}s')")
    OUT=$(printf "%s/frames/f%03d_%s.jpg" "$OUTDIR" "$i" "$MM")
    if ffmpeg -nostdin -loglevel error -ss "$T" -i "$VIDEO" \
         -frames:v 1 -vf "scale='min(768,iw)':-2" -q:v 4 -y "$OUT" 2>/dev/null && [[ -s "$OUT" ]]; then
      FRAME_LIST="${FRAME_LIST}- \`frames/$(basename "$OUT")\` (t=${MM})\n"
    else
      rm -f "$OUT"
      SKIPPED=$((SKIPPED + 1))
      echo "⚠️  第 ${i} 張影格（${MM}）抽取失敗，已跳過" >&2
    fi
    i=$((i+1))
  done <<< "$TIMES"
  if [[ $SKIPPED -gt 0 ]]; then
    FRAME_NOTE="（${FRAMES} 張中有 ${SKIPPED} 張抽取失敗，已跳過）"
  fi
fi

# ── 3b. 畫面文字 OCR（macOS Vision）──────────────────────────────────────
# Reels 常把字幕、重點字卡直接燒在畫面上。先 OCR 成文字附在影格清單，
# agent 讀一次文字就知道畫面寫什麼，不用每張圖都打開看。
# Swift 原始碼內嵌在這裡，第一次用時編譯並快取，vid 維持單一檔案、零額外套件。
OCR_NOTE=""
OCR_JSON=""
build_ocr() {
  local src hash bin
  src=$(cat <<'SWIFT'
import Foundation
import Vision

// 用法: vid-ocr <圖1> [圖2 ...]
// 輸出: JSON 陣列 [{"file": 路徑, "lines": [由上到下、由左到右的文字列]}]
var out: [[String: Any]] = []
for path in CommandLine.arguments.dropFirst() {
    let req = VNRecognizeTextRequest()
    req.recognitionLevel = .accurate
    req.usesLanguageCorrection = true
    // 寫死繁中優先：讓系統自動判斷語言有中英混排出亂碼的回報
    req.recognitionLanguages = ["zh-Hant", "en-US"]
    var lines: [String] = []
    do {
        try VNImageRequestHandler(url: URL(fileURLWithPath: path)).perform([req])
        let obs = (req.results ?? []).sorted {
            // Vision 座標原點在左下：y 大的在上面
            abs($0.boundingBox.midY - $1.boundingBox.midY) > 0.02
                ? $0.boundingBox.midY > $1.boundingBox.midY
                : $0.boundingBox.minX < $1.boundingBox.minX
        }
        for o in obs {
            guard let c = o.topCandidates(1).first, c.confidence >= 0.3 else { continue }
            let t = c.string.trimmingCharacters(in: .whitespacesAndNewlines)
            if !t.isEmpty { lines.append(t) }
        }
    } catch {
        FileHandle.standardError.write("OCR failed: \(path)\n".data(using: .utf8)!)
    }
    out.append(["file": path, "lines": lines])
}
let data = try JSONSerialization.data(withJSONObject: out, options: [])
FileHandle.standardOutput.write(data)
SWIFT
)
  hash=$(printf '%s' "$src" | shasum -a 256 | cut -c1-12)
  bin="$VID_CACHE/vid-ocr-$hash"
  if [[ ! -x "$bin" ]]; then
    mkdir -p "$VID_CACHE"
    printf '%s\n' "$src" > "$VID_CACHE/vid-ocr-$hash.swift"
    info "第一次使用 OCR，編譯中（只需一次）…"
    swiftc -O "$VID_CACHE/vid-ocr-$hash.swift" -o "$bin.tmp" >/dev/null 2>&1 || { rm -f "$bin.tmp"; return 1; }
    mv "$bin.tmp" "$bin"
  fi
  printf '%s' "$bin"
}

if [[ $DO_OCR -eq 1 && -n "$FRAME_LIST" ]]; then
  if [[ "$(uname -s)" != "Darwin" ]] || ! command -v swiftc >/dev/null 2>&1; then
    OCR_NOTE="（畫面文字：跳過，需要 macOS 與 Xcode Command Line Tools）"
  elif OCR_BIN=$(build_ocr); then
    info "辨識畫面文字…"
    if OCR_JSON=$("$OCR_BIN" "$OUTDIR"/frames/*.jpg 2>/dev/null); then
      printf '%s' "$OCR_JSON" > "$OUTDIR/ocr.json"
    else
      OCR_JSON=""
      OCR_NOTE="（畫面文字：OCR 執行失敗，已跳過）"
      echo "⚠️  OCR 執行失敗，已跳過" >&2
    fi
  else
    OCR_NOTE="（畫面文字：OCR 編譯失敗，已跳過）"
    echo "⚠️  OCR 編譯失敗（swiftc），已跳過" >&2
  fi
fi

# ── 4. 逐字稿 ────────────────────────────────────────────────────────────
TRANSCRIPT_NOTE=""
if [[ $DO_AUDIO -eq 1 && -n "$HAS_AUDIO" ]]; then
  if [[ -z "$WHISPER" ]]; then
    TRANSCRIPT_NOTE="（跳過：找不到 whisper 執行檔，跑 brew install whisper-cpp）"
  else
    MODEL_FILE="$MODEL_DIR/ggml-${MODEL}.bin"
    # checksum 只在下載當下驗一次；已存在的模型直接信任（每次重算 547 MB 要多花約 1 秒）
    if [[ ! -f "$MODEL_FILE" ]]; then
      MODEL_SHA256="${WHISPER_MODEL_SHA256:-}"
      if [[ "$MODEL" == "large-v3-turbo-q5_0" && -z "$MODEL_SHA256" ]]; then
        MODEL_SHA256="$DEFAULT_MODEL_SHA256"
      fi
      [[ -z "$MODEL_SHA256" || "$MODEL_SHA256" =~ ^[[:xdigit:]]{64}$ ]] ||
        die "WHISPER_MODEL_SHA256 必須是 64 位十六進位，收到: $MODEL_SHA256"

      mkdir -p "$MODEL_DIR"
      info "第一次使用，下載 whisper 模型 ggml-${MODEL}.bin（一次性，之後不用再下）…"
      curl -L --fail --progress-bar \
        "https://huggingface.co/ggerganov/whisper.cpp/resolve/${MODEL_REVISION}/ggml-${MODEL}.bin" \
        -o "$MODEL_FILE.part" || { rm -f "$MODEL_FILE.part"; die "模型下載失敗"; }
      if [[ -n "$MODEL_SHA256" ]]; then
        ACTUAL=$(shasum -a 256 "$MODEL_FILE.part" | awk '{print $1}')
        if [[ "$ACTUAL" != "$MODEL_SHA256" ]]; then
          rm -f "$MODEL_FILE.part"
          die "模型 checksum 不符：預期 ${MODEL_SHA256}，實際 ${ACTUAL}"
        fi
      else
        echo "⚠️  模型 $MODEL 沒有已知的 SHA-256，未驗證 checksum（可設 WHISPER_MODEL_SHA256）" >&2
      fi
      mv "$MODEL_FILE.part" "$MODEL_FILE"
    fi

    info "轉逐字稿中（本機跑，長片要等）…"
    ffmpeg -nostdin -loglevel error -i "$VIDEO" -ar 16000 -ac 1 -c:a pcm_s16le \
           -y "$OUTDIR/audio.wav" 2>/dev/null

    # -mc 0：不沿用上文。長片（>15 分鐘）不加的話，whisper 容易卡進
    #        「同一句重複幾百行」的幻覺迴圈
    WARGS=(-m "$MODEL_FILE" -f "$OUTDIR/audio.wav" -of "$OUTDIR/transcript" -otxt -osrt -pp -mc 0)
    [[ "$LANG_CODE" != "auto" ]] && WARGS+=(-l "$LANG_CODE") || WARGS+=(-l auto)

    # VAD：先用 Silero 找出有人講話的段落，只把那些段落丟給 whisper。
    # 靜音、純音樂段是幻覺迴圈最常發生的地方。VAD 只是加強，任何一步失敗都照常轉錄。
    VAD_ARGS=()
    if [[ $DO_VAD -eq 1 ]]; then
      VAD_FILE="$MODEL_DIR/ggml-${VAD_MODEL}.bin"
      if ! "$WHISPER" --help 2>&1 | grep -q -- '--vad'; then
        echo "⚠️  這版 whisper 不支援 --vad，略過（brew upgrade whisper-cpp 可升級）" >&2
      else
        if [[ ! -f "$VAD_FILE" ]]; then
          mkdir -p "$MODEL_DIR"
          info "第一次使用 VAD，下載 ggml-${VAD_MODEL}.bin（約 0.9 MB）…"
          if curl -L --fail -sS \
               "https://huggingface.co/ggml-org/whisper-vad/resolve/${VAD_REVISION}/ggml-${VAD_MODEL}.bin" \
               -o "$VAD_FILE.part" \
             && [[ "$(shasum -a 256 "$VAD_FILE.part" | awk '{print $1}')" == "$VAD_SHA256" ]]; then
            mv "$VAD_FILE.part" "$VAD_FILE"
          else
            rm -f "$VAD_FILE.part"
            echo "⚠️  VAD 模型下載或驗證失敗，這次不用 VAD" >&2
          fi
        fi
        [[ -f "$VAD_FILE" ]] && VAD_ARGS=(--vad -vm "$VAD_FILE")
      fi
    fi

    # 先帶 VAD 跑；帶 VAD 失敗（模型檔壞掉、這版 whisper 讀不了）就拿掉 VAD 重跑一次。
    # VAD 只是加強，不能因為它讓整份逐字稿消失。
    # ${VAD_ARGS[@]+...} 是為了相容 macOS 內建 bash 3.2：空陣列配 set -u 會報 unbound variable
    WHISPER_OK=0
    if "$WHISPER" "${WARGS[@]}" ${VAD_ARGS[@]+"${VAD_ARGS[@]}"} >/dev/null 2>&1; then
      WHISPER_OK=1
    elif [[ ${#VAD_ARGS[@]} -gt 0 ]]; then
      echo "⚠️  whisper 帶 VAD 執行失敗，改成不用 VAD 重跑。每次都這樣的話，刪掉 ${VAD_FILE} 讓它重新下載" >&2
      if "$WHISPER" "${WARGS[@]}" >/dev/null 2>&1; then
        WHISPER_OK=1
      fi
    fi

    if [[ $WHISPER_OK -eq 1 ]]; then
      rm -f "$OUTDIR/audio.wav"
      # whisper 中文輸出是簡體，轉成台灣正體（含用詞轉換）。
      # s2twp 的台灣詞庫偏軟體領域，少數對應在一般內容裡是錯的
      # （例：「类型」被轉成寫程式才講的「型別」）。這些改回來，
      # 其餘轉換（軟體、記憶體、影片、資訊、網路…）都保留。
      # 要再加自己的對應：VID_OPENCC_FIXES="錯的=對的,錯的=對的"
      if command -v opencc >/dev/null 2>&1; then
        for f in "$OUTDIR/transcript.txt" "$OUTDIR/transcript.srt"; do
          [[ -f "$f" ]] || continue
          if opencc -c s2twp -i "$f" -o "$f.tw" 2>/dev/null && [[ -s "$f.tw" ]]; then
            python3 -c '
import os, sys
fixes = {"型別": "類型"}
for pair in os.environ.get("VID_OPENCC_FIXES", "").split(","):
    if "=" in pair:
        bad, good = pair.split("=", 1)
        if bad.strip(): fixes[bad.strip()] = good.strip()
path = sys.argv[1]
text = open(path, encoding="utf-8").read()
for bad, good in fixes.items(): text = text.replace(bad, good)
open(path, "w", encoding="utf-8").write(text)
' "$f.tw" 2>/dev/null || true
            mv "$f.tw" "$f"
          else
            rm -f "$f.tw"
          fi
        done
      fi
      # 安全網：同一句連續出現 ≥15 次，幾乎一定是幻覺迴圈
      if [[ -f "$OUTDIR/transcript.srt" ]]; then
        MAX_REPEAT=$(awk '
          /^[0-9]+$/ || /-->/ || /^[[:space:]]*$/ { next }
          { if ($0 == prev) run++; else run = 1; prev = $0; if (run > max) max = run }
          END { print max + 0 }' "$OUTDIR/transcript.srt")
        if [[ $MAX_REPEAT -ge 15 ]]; then
          TRANSCRIPT_NOTE="（⚠️ 偵測到同一句連續重複 ${MAX_REPEAT} 次，可能是 whisper 幻覺，該段內容不可信）"
          echo "⚠️  逐字稿有同一句連續重複 ${MAX_REPEAT} 次，可能是 whisper 幻覺" >&2
        fi
      fi
    else
      TRANSCRIPT_NOTE="（whisper 執行失敗，audio.wav 留著讓你手動試）"
    fi
  fi
elif [[ -z "$HAS_AUDIO" ]]; then
  TRANSCRIPT_NOTE="（這支影片沒有音軌）"
fi

# ── 5. 保留原始影片 ──────────────────────────────────────────────────────
if [[ $KEEP_VIDEO -eq 1 && "$INPUT" =~ ^https?:// ]]; then
  cp "$VIDEO" "$OUTDIR/source.${VIDEO##*.}"
fi
# TMPD 交給 EXIT trap 清，這裡不用再手動 rm

# ── 6. 產生給 Claude 讀的 README.md ──────────────────────────────────────
{
  echo "# 影片內容包"
  echo ""
  echo "- 來源: \`$INPUT\`"
  echo "- 時長: ${DURATION}s ｜ 解析度: ${RES:-無畫面}"
  echo "- 產生時間: $(date '+%Y-%m-%d %H:%M:%S')"
  echo ""
  if [[ -f "$OUTDIR/meta.json" ]]; then
    echo "## 貼文 / 影片 metadata"
    echo ""
    python3 - "$OUTDIR/meta.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1], encoding="utf-8"))
for k in ('title','uploader','channel','upload_date','duration','view_count','like_count','comment_count','webpage_url'):
    if d.get(k) not in (None,''):
        print(f"- **{k}**: {d[k]}")
desc=(d.get('description') or '').strip()
if desc:
    print("\n### 原始貼文文字\n")
    print("```")
    print(desc[:4000])
    print("```")
PY
    echo ""
  fi
  echo "## 逐字稿 $TRANSCRIPT_NOTE"
  echo ""
  if [[ -f "$OUTDIR/transcript.txt" ]]; then
    echo '```'
    cat "$OUTDIR/transcript.txt"
    echo '```'
    echo ""
    echo "帶時間軸版本: \`transcript.srt\`"
  else
    echo "_無_"
  fi
  echo ""
  if [[ -n "$OCR_JSON" ]]; then
    echo "## 影格（畫面上的文字已辨識，附在各張下方；要看畫面再用 Read 工具開圖）${FRAME_NOTE}"
  else
    echo "## 影格（用 Read 工具逐張看）${FRAME_NOTE}${OCR_NOTE}"
  fi
  echo ""
  if [[ -n "$FRAME_LIST" && -n "$OCR_JSON" ]]; then
    # 每張影格下面附 OCR 結果；跟上一張一模一樣就不重複貼（燒錄字幕常連續好幾張相同）
    # shellcheck disable=SC2016  # 單引號裡是 Python 程式碼，本來就不該被 shell 展開
    printf "%b" "$FRAME_LIST" | python3 -c '
import json, os, sys
ocr = {os.path.basename(d["file"]): d["lines"] for d in json.load(open(sys.argv[1], encoding="utf-8"))}
prev = None
for line in sys.stdin.read().splitlines():
    print(line)
    name = line.split("`")[1].split("/")[-1] if "`" in line else ""
    lines = ocr.get(name)
    if lines is None:
        continue
    if not lines:
        print("  - 畫面文字：（無）")
    elif lines == prev:
        print("  - 畫面文字：（同上一張）")
    else:
        print("  - 畫面文字：")
        for t in lines:
            print("    > " + t)
    prev = lines
' "$OUTDIR/ocr.json"
  elif [[ -n "$FRAME_LIST" ]]; then
    printf "%b" "$FRAME_LIST"
  else
    echo "_無_"
  fi
} > "$OUTDIR/README.md"
COMPLETED=1

echo ""
echo "✅ 完成 → $OUTDIR"
echo "   叫 Claude 讀: $OUTDIR/README.md（逐字稿都在裡面），要看畫面就讀 frames/ 底下的圖"
