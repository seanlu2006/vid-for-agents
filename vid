#!/usr/bin/env bash
# vid — 把影片變成「Claude 讀得懂的東西」：抽樣影格(圖) + 逐字稿(文字) + meta
#
# 用法:
#   vid <URL或本機檔案> [選項]
#
# 選項:
#   -n, --frames N      抽幾張影格 (預設 12)
#   -l, --lang CODE     逐字稿語言 (預設 auto；中文用 zh，英文用 en)
#   -c, --cookies BROWSER  用瀏覽器 cookie 抓需登入的內容 (chrome/safari/firefox/edge)
#   -o, --outdir DIR    輸出根目錄 (預設 ~/media-out)
#       --no-frames     不抽影格（只要逐字稿）
#       --no-audio      不轉逐字稿（只要影格）
#       --keep-video    保留原始影片檔（預設保留；用 --no-keep 刪掉省空間）
#       --no-keep       處理完刪掉原始影片
#       --model NAME    whisper 模型 (預設 large-v3-turbo-q5_0)
#                       自訂模型可設 WHISPER_MODEL_SHA256 讓首次下載時驗證
#   -h, --help          這段說明
#
# 輸出: <outdir>/<標題slug>-<時間戳>/
#   ├── README.md      ← 給 Claude 讀的入口（含 meta + 逐字稿全文 + 影格清單）
#   ├── meta.json      ← yt-dlp 抓到的原始 metadata
#   ├── frames/        ← f001.jpg ... 依時間排序，檔名含秒數
#   ├── transcript.txt ← 純文字逐字稿
#   ├── transcript.srt ← 帶時間軸
#   └── source.*       ← 原始影片

set -euo pipefail

FRAMES=12
LANG_CODE="auto"
COOKIES=""
OUTROOT="$HOME/media-out"
DO_FRAMES=1
DO_AUDIO=1
KEEP_VIDEO=1
MODEL="large-v3-turbo-q5_0"
MODEL_DIR="$HOME/.cache/whisper-models"
MODEL_REVISION="5359861c739e955e79d9a303bcbc70fb988958b1"
# Hugging Face LFS oid (SHA-256) for the default model at MODEL_REVISION.
DEFAULT_MODEL_SHA256="394221709cd5ad1f40c46e6031ca61bce88931e6e088c188294c6d5a55ffa7e2"

die() { echo "❌ $*" >&2; exit 1; }
info() { echo "→ $*" >&2; }

# ── slug：把標題/檔名轉成安全的目錄名 ────────────────────────────────────
# URL 與本機檔兩條路徑共用同一套規則，避免行為分歧。
# 保留 0-9 A-Z a-z 與 CJK 漢字(U+4E00-U+9FFF)，其餘一律收斂成單一 "-"。
slugify() {
  printf '%s' "$1" | python3 -c '
import re, sys
t = sys.stdin.buffer.read().decode("utf-8", "replace")
t = re.sub(r"[^0-9A-Za-z\u4e00-\u9fff]+", "-", t).strip("-")[:50].strip("-")
print(t or "video")
'
}

[[ $# -eq 0 ]] && { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }

# ── 吃參數的選項：缺參數/型別錯，在解析階段就擋下來 ──────────────────────
# $1=選項名  $2=剩下的參數個數(含選項本身)  $3=參數值(可能不存在)
need_val() {
  local opt="$1" argc="$2" val="${3:-}"
  [[ $argc -ge 2 ]] || die "選項 $opt 需要一個參數"
  [[ -n "$val" ]] || die "選項 $opt 的參數不能是空的"
  [[ "$val" == -* ]] && die "選項 $opt 需要一個參數，但後面接到的是另一個選項: $val"
  return 0
}

INPUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--frames)
      [[ $# -ge 2 ]] || die "選項 $1 需要一個數字參數，例如: -n 12"
      [[ "$2" =~ ^[0-9]+$ ]] || die "選項 $1 需要一個大於 0 的整數，收到: $2"
      [[ "$2" -gt 0 ]] || die "選項 $1 需要一個大於 0 的整數，收到: $2"
      FRAMES="$2"; shift 2 ;;
    -l|--lang)
      need_val "$1" $# "${2:-}"
      [[ "$2" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]] || die "選項 $1 需要一個語言代碼（auto / zh / en …），收到: $2"
      LANG_CODE="$2"; shift 2 ;;
    -c|--cookies)
      need_val "$1" $# "${2:-}"
      COOKIES="$2"; shift 2 ;;
    -o|--outdir)
      need_val "$1" $# "${2:-}"
      OUTROOT="$2"; shift 2 ;;
    --model)
      need_val "$1" $# "${2:-}"
      [[ "$2" =~ ^[A-Za-z0-9._-]+$ ]] || die "選項 $1 的模型名只能有英數字與 . _ -，收到: $2"
      MODEL="$2"; shift 2 ;;
    --no-frames)  DO_FRAMES=0; shift ;;
    --no-audio)   DO_AUDIO=0; shift ;;
    --keep-video) KEEP_VIDEO=1; shift ;;
    --no-keep)    KEEP_VIDEO=0; shift ;;
    -h|--help)    sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)           die "不認識的選項: $1" ;;
    *)            INPUT="$1"; shift ;;
  esac
done

[[ -z "$INPUT" ]] && die "要給我一個 URL 或影片檔路徑"

command -v ffmpeg  >/dev/null || die "沒裝 ffmpeg。跑: brew install ffmpeg"
command -v ffprobe >/dev/null || die "沒裝 ffprobe（在 ffmpeg 裡）"
command -v python3 >/dev/null || die "沒裝 python3。macOS 跑: xcode-select --install（或 brew install python）"

# ── whisper 二進位名字在不同版本不一樣，逐一找 ────────────────────────────
WHISPER=""
for c in whisper-cli whisper-cpp whisper main; do
  if command -v "$c" >/dev/null 2>&1; then WHISPER="$c"; break; fi
done

STAMP=$(date +%Y%m%d-%H%M%S)

# ── 暫存目錄：不管正常結束還是中途失敗（下載失敗、Ctrl-C、ffmpeg 爆掉）
#    都要清掉，別把整支影片留在 /var/folders。宣告在 TMPD 可能被建立之前，
#    並用 ${TMPD:-} 以相容 set -u。
TMPD=""
OUTDIR=""
COMPLETED=0
cleanup() {
  [[ -n "${TMPD:-}" ]] && rm -rf "$TMPD"
  # 中途失敗就把這次建立的輸出目錄整個收掉，不留半成品
  [[ $COMPLETED -eq 0 && -n "${OUTDIR:-}" ]] && rm -rf "$OUTDIR"
  return 0
}
trap cleanup EXIT

# ── 1. 取得影片：URL 就下載，本機檔就複製路徑 ─────────────────────────────
VIDEO=""
META_JSON=""

if [[ "$INPUT" =~ ^https?:// ]]; then
  command -v yt-dlp >/dev/null || die "沒裝 yt-dlp。跑: brew install yt-dlp"
  TMPD=$(mktemp -d)
  YTARGS=(-f "bv*[height<=1080]+ba/b" --merge-output-format mp4
          --write-info-json --no-playlist --restrict-filenames
          -o "$TMPD/src.%(ext)s")
  [[ -n "$COOKIES" ]] && YTARGS+=(--cookies-from-browser "$COOKIES")

  info "下載中: $INPUT"
  if ! yt-dlp "${YTARGS[@]}" "$INPUT"; then
    # Threads 沒有專屬 extractor，用 generic 撈 og:video 再試一次
    info "專屬 extractor 失敗，改用 generic 模式重試…"
    if ! yt-dlp "${YTARGS[@]}" --force-generic-extractor "$INPUT"; then
      echo "" >&2
      echo "下載失敗。常見原因：" >&2
      echo "  • 需要登入（IG/Threads 大多要）→ 加 -c chrome 用你瀏覽器的 cookie" >&2
      echo "  • Threads 目前 yt-dlp 無專屬支援，只能靠 generic 撈 og:video，不保證成功" >&2
      echo "  • yt-dlp 太舊 → brew upgrade yt-dlp" >&2
      exit 1
    fi
  fi

  VIDEO=$(find "$TMPD" -maxdepth 1 -type f ! -name '*.info.json' | head -1)
  META_JSON=$(find "$TMPD" -maxdepth 1 -name '*.info.json' | head -1)
  [[ -z "$VIDEO" ]] && die "下載完卻找不到檔案"

  RAW_TITLE=$(python3 -c "
import json,sys
try:
    d=json.load(open(sys.argv[1]))
    t=d.get('title') or d.get('id') or 'video'
except Exception:
    t='video'
print(t)
" "$META_JSON" 2>/dev/null || echo "video")
  TITLE=$(slugify "$RAW_TITLE")
else
  [[ -f "$INPUT" ]] || die "檔案不存在: $INPUT"
  VIDEO="$INPUT"
  TITLE=$(slugify "$(basename "${INPUT%.*}")")
fi

# ── 2. 基本資訊 ──────────────────────────────────────────────────────────
DURATION_RAW=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$VIDEO" 2>/dev/null) ||
  die "ffprobe 讀取影片時長失敗"
[[ "$DURATION_RAW" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
  die "ffprobe 回傳無效的影片時長: $DURATION_RAW"
DURATION="${DURATION_RAW%%.*}"
RES=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$VIDEO" 2>/dev/null) ||
  die "ffprobe 讀取影片解析度失敗"
RES=$(printf '%s\n' "$RES" | head -1)
# 空字串 = 沒有畫面串流（podcast、語音訊息），照樣做逐字稿
[[ -z "$RES" || "$RES" =~ ^[0-9]+x[0-9]+$ ]] || die "ffprobe 回傳無效的影片解析度: $RES"

# 抽影格要照「畫面串流」的長度，不是容器長度。
# Reels 常見畫面 3 秒、配樂 10 秒，用容器長度會抽到畫面結束之後的空白時間點。
VDUR="$DURATION_RAW"
if [[ -n "$RES" ]]; then
  VDUR_RAW=$(ffprobe -v error -select_streams v:0 -show_entries stream=duration -of csv=p=0 "$VIDEO" 2>/dev/null | head -1 || true)
  # mkv/webm 常沒有串流長度（N/A），退回容器長度
  [[ "$VDUR_RAW" =~ ^[0-9]+([.][0-9]+)?$ ]] && VDUR="$VDUR_RAW"
fi
HAS_AUDIO=$(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 "$VIDEO" 2>/dev/null) ||
  die "ffprobe 讀取音軌資訊失敗"
HAS_AUDIO=$(printf '%s\n' "$HAS_AUDIO" | head -1)
info "時長 ${DURATION}s / 解析度 ${RES:-無畫面}"

mkdir -p "$OUTROOT"
OUTDIR="$OUTROOT/${TITLE}-${STAMP}"
suffix=0
while ! mkdir "$OUTDIR" 2>/dev/null; do
  [[ -e "$OUTDIR" ]] || die "無法建立輸出目錄: $OUTDIR"
  suffix=$((suffix + 1))
  OUTDIR="$OUTROOT/${TITLE}-${STAMP}-${suffix}"
done
[[ -n "$META_JSON" ]] && cp "$META_JSON" "$OUTDIR/meta.json"

# ── 3. 抽影格 ────────────────────────────────────────────────────────────
FRAME_LIST=""
FRAME_NOTE=""
if [[ $DO_FRAMES -eq 1 && -z "$RES" ]]; then
  FRAME_NOTE="（這個檔案沒有畫面）"
elif [[ $DO_FRAMES -eq 1 ]] && python3 -c "import sys; sys.exit(0 if float('$VDUR') > 0 else 1)"; then
  mkdir -p "$OUTDIR/frames"
  info "抽 $FRAMES 張影格…"
  SKIPPED=0
  i=1
  while [[ $i -le $FRAMES ]]; do
    # 在畫面串流長度內均勻取樣，取每段中點，避開頭尾黑畫面
    T=$(python3 -c "print(round($VDUR*($i-0.5)/$FRAMES,2))")
    MM=$(python3 -c "print(f'{int($T)//60:02d}m{int($T)%60:02d}s')")
    OUT=$(printf "%s/frames/f%03d_%s.jpg" "$OUTDIR" "$i" "$MM")
    if ffmpeg -nostdin -loglevel error -ss "$T" -i "$VIDEO" \
         -frames:v 1 -vf "scale='min(768,iw)':-2" -q:v 4 -y "$OUT" 2>/dev/null && [[ -s "$OUT" ]]; then
      FRAME_LIST="${FRAME_LIST}- \`frames/$(basename "$OUT")\` (t=${MM})\n"
    else
      rm -f "$OUT"
      SKIPPED=$((SKIPPED + 1))
      echo "⚠️  第 ${i} 張影格（${MM}）抽取失敗，已跳過" >&2
    fi
    i=$((i+1))
  done
  if [[ $SKIPPED -gt 0 ]]; then
    FRAME_NOTE="（${FRAMES} 張中有 ${SKIPPED} 張抽取失敗，已跳過）"
  fi
fi

# ── 4. 逐字稿 ────────────────────────────────────────────────────────────
TRANSCRIPT_NOTE=""
if [[ $DO_AUDIO -eq 1 && -n "$HAS_AUDIO" ]]; then
  if [[ -z "$WHISPER" ]]; then
    TRANSCRIPT_NOTE="（跳過：找不到 whisper 執行檔，跑 brew install whisper-cpp）"
  else
    MODEL_FILE="$MODEL_DIR/ggml-${MODEL}.bin"
    # checksum 只在下載當下驗一次；已存在的模型直接信任（每次重算 547 MB 要多花約 1 秒）
    if [[ ! -f "$MODEL_FILE" ]]; then
      MODEL_SHA256="${WHISPER_MODEL_SHA256:-}"
      if [[ "$MODEL" == "large-v3-turbo-q5_0" && -z "$MODEL_SHA256" ]]; then
        MODEL_SHA256="$DEFAULT_MODEL_SHA256"
      fi
      [[ -z "$MODEL_SHA256" || "$MODEL_SHA256" =~ ^[[:xdigit:]]{64}$ ]] ||
        die "WHISPER_MODEL_SHA256 必須是 64 位十六進位，收到: $MODEL_SHA256"

      mkdir -p "$MODEL_DIR"
      info "第一次使用，下載 whisper 模型 ggml-${MODEL}.bin（一次性，之後不用再下）…"
      curl -L --fail --progress-bar \
        "https://huggingface.co/ggerganov/whisper.cpp/resolve/${MODEL_REVISION}/ggml-${MODEL}.bin" \
        -o "$MODEL_FILE.part" || { rm -f "$MODEL_FILE.part"; die "模型下載失敗"; }
      if [[ -n "$MODEL_SHA256" ]]; then
        ACTUAL=$(shasum -a 256 "$MODEL_FILE.part" | awk '{print $1}')
        if [[ "$ACTUAL" != "$MODEL_SHA256" ]]; then
          rm -f "$MODEL_FILE.part"
          die "模型 checksum 不符：預期 $MODEL_SHA256，實際 $ACTUAL"
        fi
      else
        echo "⚠️  模型 $MODEL 沒有已知的 SHA-256，未驗證 checksum（可設 WHISPER_MODEL_SHA256）" >&2
      fi
      mv "$MODEL_FILE.part" "$MODEL_FILE"
    fi

    info "轉逐字稿中（本機跑，長片要等）…"
    ffmpeg -nostdin -loglevel error -i "$VIDEO" -ar 16000 -ac 1 -c:a pcm_s16le \
           -y "$OUTDIR/audio.wav" 2>/dev/null

    # -mc 0：不沿用上文。長片（>15 分鐘）不加的話，whisper 容易卡進
    #        「同一句重複幾百行」的幻覺迴圈
    WARGS=(-m "$MODEL_FILE" -f "$OUTDIR/audio.wav" -of "$OUTDIR/transcript" -otxt -osrt -pp -mc 0)
    [[ "$LANG_CODE" != "auto" ]] && WARGS+=(-l "$LANG_CODE") || WARGS+=(-l auto)

    if "$WHISPER" "${WARGS[@]}" >/dev/null 2>&1; then
      rm -f "$OUTDIR/audio.wav"
      # whisper 中文輸出是簡體，轉成台灣正體（含用詞轉換）
      if command -v opencc >/dev/null 2>&1; then
        for f in "$OUTDIR/transcript.txt" "$OUTDIR/transcript.srt"; do
          [[ -f "$f" ]] || continue
          if opencc -c s2twp -i "$f" -o "$f.tw" 2>/dev/null && [[ -s "$f.tw" ]]; then
            mv "$f.tw" "$f"
          else
            rm -f "$f.tw"
          fi
        done
      fi
      # 安全網：同一句連續出現 ≥15 次，幾乎一定是幻覺迴圈
      if [[ -f "$OUTDIR/transcript.srt" ]]; then
        MAX_REPEAT=$(awk '
          /^[0-9]+$/ || /-->/ || /^[[:space:]]*$/ { next }
          { if ($0 == prev) run++; else run = 1; prev = $0; if (run > max) max = run }
          END { print max + 0 }' "$OUTDIR/transcript.srt")
        if [[ $MAX_REPEAT -ge 15 ]]; then
          TRANSCRIPT_NOTE="（⚠️ 偵測到同一句連續重複 ${MAX_REPEAT} 次，可能是 whisper 幻覺，該段內容不可信）"
          echo "⚠️  逐字稿有同一句連續重複 ${MAX_REPEAT} 次，可能是 whisper 幻覺" >&2
        fi
      fi
    else
      TRANSCRIPT_NOTE="（whisper 執行失敗，audio.wav 留著讓你手動試）"
    fi
  fi
elif [[ -z "$HAS_AUDIO" ]]; then
  TRANSCRIPT_NOTE="（這支影片沒有音軌）"
fi

# ── 5. 保留原始影片 ──────────────────────────────────────────────────────
if [[ $KEEP_VIDEO -eq 1 && "$INPUT" =~ ^https?:// ]]; then
  cp "$VIDEO" "$OUTDIR/source.${VIDEO##*.}"
fi
# TMPD 交給 EXIT trap 清，這裡不用再手動 rm

# ── 6. 產生給 Claude 讀的 README.md ──────────────────────────────────────
{
  echo "# 影片內容包"
  echo ""
  echo "- 來源: \`$INPUT\`"
  echo "- 時長: ${DURATION}s ｜ 解析度: ${RES:-無畫面}"
  echo "- 產生時間: $(date '+%Y-%m-%d %H:%M:%S')"
  echo ""
  if [[ -f "$OUTDIR/meta.json" ]]; then
    echo "## 貼文 / 影片 metadata"
    echo ""
    python3 - "$OUTDIR/meta.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))
for k in ('title','uploader','channel','upload_date','duration','view_count','like_count','comment_count','webpage_url'):
    if d.get(k) not in (None,''):
        print(f"- **{k}**: {d[k]}")
desc=(d.get('description') or '').strip()
if desc:
    print("\n### 原始貼文文字\n")
    print("```")
    print(desc[:4000])
    print("```")
PY
    echo ""
  fi
  echo "## 逐字稿 $TRANSCRIPT_NOTE"
  echo ""
  if [[ -f "$OUTDIR/transcript.txt" ]]; then
    echo '```'
    cat "$OUTDIR/transcript.txt"
    echo '```'
    echo ""
    echo "帶時間軸版本: \`transcript.srt\`"
  else
    echo "_無_"
  fi
  echo ""
  echo "## 影格（用 Read 工具逐張看）$FRAME_NOTE"
  echo ""
  if [[ -n "$FRAME_LIST" ]]; then
    printf "%b" "$FRAME_LIST"
  else
    echo "_無_"
  fi
} > "$OUTDIR/README.md"
COMPLETED=1

echo ""
echo "✅ 完成 → $OUTDIR"
echo "   叫 Claude 讀: $OUTDIR/README.md（逐字稿都在裡面），要看畫面就讀 frames/ 底下的圖"
